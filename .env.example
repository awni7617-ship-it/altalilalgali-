# ==========================================================
#  Al-Talil Al-Ghali — configuration
#  Copy this file to ".env" and fill in your own values.
#  cp .env.example .env
# ==========================================================

# ---- Server ----------------------------------------------
PORT=3000
NODE_ENV=production

# Public URL of the shop (used in e-mails). No trailing slash.
PUBLIC_URL=http://localhost:3000

# ---- Security --------------------------------------------
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If you leave it empty, a random secret is generated on each start,
# which logs everybody out every time the server restarts.
SECRET_KEY=

# ---- Owner / admin accounts ------------------------------
# Comma-separated list. Anyone who signs in with one of these
# addresses automatically becomes an admin.
ADMIN_EMAILS=carsyardltd@icloud.com

# ---- E-mail delivery -------------------------------------
# The login code is e-mailed to the user. Choose ONE provider.
#
#   MAIL_PROVIDER=console   -> no e-mail, the code is printed in the
#                              server terminal. Great for testing.
#   MAIL_PROVIDER=smtp      -> any SMTP server (Gmail, iCloud, Zoho...)
#   MAIL_PROVIDER=resend    -> https://resend.com  (easiest, free tier)
#   MAIL_PROVIDER=brevo     -> https://brevo.com   (free tier, 300/day)
MAIL_PROVIDER=console

MAIL_FROM_NAME=Al-Talil Al-Ghali
MAIL_FROM=no-reply@example.com

# --- if MAIL_PROVIDER=smtp --------------------------------
# Gmail   : smtp.gmail.com     port 465  (use an "App password")
# iCloud  : smtp.mail.me.com   port 587  (use an "App-specific password")
# Zoho    : smtp.zoho.com      port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# "true" for port 465 (implicit TLS), "false" for 587 (STARTTLS)
SMTP_SECURE=true

# --- if MAIL_PROVIDER=resend ------------------------------
# MAIL_FROM must be an address on a domain you verified with Resend.
# Before you verify one, use onboarding@resend.dev — but note that it
# only delivers to the address you signed up to Resend with, so verify
# your own domain before customers start signing in.
RESEND_API_KEY=

# --- if MAIL_PROVIDER=brevo -------------------------------
BREVO_API_KEY=

# Only needed to post through a regional endpoint or a company relay.
# Leave both empty to use the providers' normal API hosts.
RESEND_API_URL=
BREVO_API_URL=

# ---- Login code behaviour --------------------------------
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
CODE_REQUESTS_PER_HOUR=5
SESSION_DAYS=30

# ---- Shop defaults (editable later in the admin panel) ----
SHOP_WHATSAPP=970590000000
