# ==========================================================
#  Al-Talil Al-Ghali — configuration
#  Copy this file to ".env" and fill in your own values.
#  cp .env.example .env
# ==========================================================

# ---- Server ----------------------------------------------
PORT=3000
NODE_ENV=production

# Public address of the shop. No trailing slash.
PUBLIC_URL=http://localhost:3000

# ---- Security --------------------------------------------
# REQUIRED in production. Generate one with:  npm run secret
# If you leave it empty, a random key is made on every start,
# which signs everybody out each time the server restarts.
SECRET_KEY=

# ---- Owner / admin accounts ------------------------------
# Comma-separated. Anyone who signs in with one of these
# addresses is an admin; anyone else is a customer.
ADMIN_EMAILS=carsyardltd@icloud.com

# The owner's password.
#
# Leave this EMPTY and a strong password is generated the first
# time the shop starts and printed once in the terminal — write
# it down. That is the recommended way.
#
# Set it here instead if you would rather choose your own; it is
# then applied to the owner account on every start.
#
# Either way you can change it later from your account page, or
# with:  npm run password
ADMIN_PASSWORD=

# ---- Who can see the shop --------------------------------
# true  = visitors must sign in before they see any products
# false = anyone can browse; only the dashboard needs signing in
#
# Requiring sign-in protects your catalogue and prices, but every
# new customer has to make an account before they can buy, which
# does lose some sales. Your call.
REQUIRE_LOGIN=true

# ---- Sign in with Google ---------------------------------
# Free. https://console.cloud.google.com → APIs & Services →
# Credentials → Create OAuth client ID → Web application.
# Add this exact address under "Authorized redirect URIs":
#   <PUBLIC_URL>/auth/google/callback
# Leave these empty and the Google button simply does not appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Sign in with Apple ----------------------------------
# Needs a paid Apple Developer account ($99/year). At
# developer.apple.com create a Services ID and a Sign-in key (.p8),
# and register <PUBLIC_URL>/auth/apple/callback as the Return URL.
# Leave these empty and the Apple button simply does not appear.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the whole .p8 file. Keep it on one line using \n for newlines,
# or wrap the whole thing in quotes across several lines.
APPLE_PRIVATE_KEY=

# ---- Sign-in rules ---------------------------------------
SESSION_DAYS=30
MIN_PASSWORD_LENGTH=8
# Wrong guesses allowed before an address is locked out.
MAX_LOGIN_ATTEMPTS=8
LOCKOUT_MINUTES=15

# ---- Shop defaults (editable later in the admin panel) ----
SHOP_WHATSAPP=970590000000
