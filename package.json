  "description": "Al-Talil Al-Ghali — online makeup shop for Palestine, with passwordless email-code login and a full admin dashboard.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "NODE_ENV=development node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "reset": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
  },
  "dependencies": {}
}
