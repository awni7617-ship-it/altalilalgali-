{
  "name": "altalil-al-gali",
  "version": "1.0.0",
  "description": "Al-Talil Al-Ghali — online makeup shop for Palestine, running entirely on Cloudflare Pages, D1 and R2.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --local --port 3000",
    "db:local": "wrangler d1 execute altalil-shop-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute altalil-shop-db --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy",
    "secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^4.129.1"
  }
}
