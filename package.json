{
  "name": "dar-al-kohl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "دار الكحل — a Palestinian makeup shop on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:cf": "CI=true wrangler d1 migrations apply darkohl --remote && CI=true wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply darkohl --local",
    "migrate": "wrangler d1 migrations apply darkohl --remote",
    "build:migration": "node scripts/build-migration.mjs",
    "artifact": "node artifact/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
